snippet contextdecorator "context manager decorator" b
# https://docs.python.org/3/library/contextlib.html
from contextlib import contextmanager

@contextmanager
def managed():
    print("entered")
    try:
        yield
    finally:
        print("cleanup")

with managed():
    print("middle")

# https://docs.python.org/3/library/contextlib.html
@contextmanager
def managed_complex(resource: str):
    print("entered")
    try:
        yield resource.upper()
    finally:
        print("cleanup")

with managed_complex("test") as m:
    print(m)
endsnippet
