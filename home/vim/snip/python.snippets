from dataclasses import dataclass, field

@dataclass(frozen=True)
class ${1:Point}:
    x: int
    y: int = 0
    description: str = ""
    others: list[int] = field(default_factory=list)

	# access via p.sum
	@property
	def sum(self) -> int:
		return self.x + self.y
