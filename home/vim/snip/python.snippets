snippet test-doctest "test doctest base"
#!/usr/bin/env python3
# run with: python3 -m doctest file.py
def transform_authors(authors: str):
    """
    transforms authors string in a way that:

    >>> transform_authors("Author A; Author B")
    ('Author B', 'Author A')
    """
    return tuple(reversed([a.strip() for a in authors.split(";")]))
endsnippet


snippet "dot1|dotdict1" "DotDict read" br
# for more complex uses: https://pypi.org/project/dotmap/

class ${1:DotDict}(dict):
    """
    access a dict with dot notation: mydict.key_blabla instead of mydict["key-blabla"]
    """
    def __getattr__(self, attr):
        if attr in self:
            return self[attr]
        return self[attr.replace("_", "-")]
    def __getstate__(self):
        return self
endsnippet


snippet "dot2|dotdict2" "DotDict write" br
from types import SimpleNamespace
from typing import Any

class DotDict(SimpleNamespace):
    def __getattr__(self, name: str) -> Any:
        value = DotDict()
        setattr(self, name, value)
        return value

def dot_dict(obj: Any) -> Any:
    if isinstance(obj, dict):
        return DotDict(**{key: dot_dict(value) for key, value in obj.items()})
    if isinstance(obj, list):
        return [dot_dict(item) for item in obj]
    if isinstance(obj, tuple):
        return tuple(dot_dict(item) for item in obj)
    return obj

data = dot_dict(
    {
        "name": "Alice",
        "address": {
            "city": "NY",
        },
    }
)
data.foo.bar = ["baz", "x"]
print(data)
print(data.name)
print(data.foo.bar)
print(data.address.city)
endsnippet


